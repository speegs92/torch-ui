@namespace TorchUI.Bootstrap.Components

@inherits BaseField<TValue?>
@typeparam TValue

<fieldset @attributes="UserAttributes">
	@if (!string.IsNullOrEmpty(Label))
	{
		<legend>@Label</legend>
	}

	<InputRadioGroup
		Value="@Value"
		ValueChanged="ValueChanged"
		ValueExpression="ValueExpression">
		@if (Options is not null && RadioTemplate is not null)
		{
			foreach (var option in Options)
			{
				@RadioTemplate(option)
			}
		}

		@ChildContent
	</InputRadioGroup>

	@if (!string.IsNullOrEmpty(FormText))
	{
		<FormText>
			@FormText
		</FormText>
	}

	<FieldValidationMessage For="ValueExpression"/>
</fieldset>
