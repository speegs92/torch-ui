@* ReSharper disable once CheckNamespace *@
@namespace TorchUI.Bootstrap.Components

@typeparam TValue
@inherits BaseField<TValue?>

<TorchComponentBase
	Tag="@Tag"
	class="@CssBuilder.Build()">
	@if (!string.IsNullOrEmpty(Label))
	{
		<label
			for="@Id"
			class="form-label">
			@Label
		</label>
	}

	<InputSelect
		Value="Value"
		ValueChanged="ValueChanged"
		ValueExpression="ValueExpression"
		@attributes="UserAttributes"
		id="@Id"
		class="form-select">
		@if (ShowNullOption)
		{
			<option disabled>
				@NullOptionText
			</option>
		}

		@if (Options is not null && OptionTemplate is not null)
		{
			@foreach (var option in Options)
			{
				@OptionTemplate(option)
			}
		}

		@ChildContent
	</InputSelect>

	<FieldValidationMessage For="ValueExpression"/>
</TorchComponentBase>
