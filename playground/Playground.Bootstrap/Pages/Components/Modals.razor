@page "/components/modals"

<DocPage Title="Modals">
	<DocSection
		Subpath="components/modal/#modal-components"
		Title="Modal components">
		<Modal Show>
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>Modal body text goes here.</p>
			</ModalBody>

			<ModalFooter>
				<Button Color="Primary">
					Save changes
				</Button>
				<Button Color="Secondary">
					Close
				</Button>
			</ModalFooter>
		</Modal>
	</DocSection>

	<DocSection
		Subpath="components/modal/#live-demo"
		Title="Live demo">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#exampleModal">
			Launch demo modal
		</Button>

		<Modal
			Fade
			id="exampleModal">
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>
					Woo-hoo, you’re reading this text in a modal!
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Save changes
				</Button>
			</ModalFooter>
		</Modal>

		<Interjection>
			<strong>FYI:</strong> To create a close button for a Bootstrap modal, create a <code>&lt;Button Dismiss="Toggle.Modal"&gt;</code> as a child element of the modal. The <code>&lt;ModalHeader&gt;</code> automatically renders a <code>&lt;CloseButton&gt;</code>, so you will only need to supply this button if you supply custom markup to <code>&lt;ModalHeader&gt;</code>.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/modal/#static-backdrop"
		Title="Static backdrop">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#staticBackdrop">
			Launch static backdrop modal
		</Button>

		<Modal
			Fade
			Static
			DisableKeyboard
			id="staticBackdrop">
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>
					I will not close if you click outside of me. Don’t even try to press escape key.
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Understood
				</Button>
			</ModalFooter>
		</Modal>

		<Interjection>
			<strong>Be aware:</strong> The static backdrop is enabled separately from disabling the escape key. In the Bootstrap 5.3 docs, this is buried in the technical documentation. The keyboard is disabled in this example because the keyboard is also disabled in the static modal example, even though that functionality is separate from the static modal functionality.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/modal/#scrolling-long-content"
		Title="Scrolling long content">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#longContent">
			Long content modal
		</Button>

		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#scrollable">
			Scrollable modal
		</Button>

		<Modal
			Fade
			id="longContent">
			<ModalHeader Title="Modal title"/>

			<ModalBody class="min-vh-100">
				<p>
					This is some placeholder content to show the scrolling behavior for modals. Instead of repeating the text in the modal, we use an inline style to set a minimum height, thereby extending the length of the overall modal and demonstrating the overflow scrolling. When content becomes longer than the height of the viewport, scrolling will move the modal as needed.
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Save changes
				</Button>
			</ModalFooter>
		</Modal>

		<Modal
			Fade
			Scrollable
			id="scrollable">
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>
					This is some placeholder content to show the scrolling behavior for modals. We use repeated line breaks to demonstrate how content can exceed minimum inner height, thereby showing inner scrolling. When content becomes longer than the predefined max-height of modal, content will be cropped and scrollable within the modal.
				</p>
				<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>

				<p>
					This content should appear at the bottom after you scroll.
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Save changes
				</Button>
			</ModalFooter>
		</Modal>
	</DocSection>

	<DocSection
		Subpath="components/modal/#vertically-centered"
		Title="Vertically centered">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#verticallyCentered">
			Launch vertically centered modal
		</Button>

		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#centeredScrollable">
			Launch vertically centered scrollable modal
		</Button>

		<Modal
			Fade
			Centered
			id="verticallyCentered">
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>
					This is a vertically centered modal.
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Save changes
				</Button>
			</ModalFooter>
		</Modal>

		<Modal
			Fade
			Centered
			Scrollable
			id="centeredScrollable">
			<ModalHeader Title="Modal title"/>

			<ModalBody>
				<p>
					This is some placeholder content to show a vertically centered modal. We’ve added some extra copy here to show how vertically centering the modal works when combined with scrollable modals. We also use some repeated line breaks to quickly extend the height of the content, thereby triggering the scrolling. When content becomes longer than the predefined max-height of modal, content will be cropped and scrollable within the modal.
				</p>
				<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>

				<p>
					Just like that.
				</p>
			</ModalBody>

			<ModalFooter>
				<Button
					Color="Secondary"
					Outlined
					Dismiss="Toggle.Modal">
					Close
				</Button>
				<Button Color="Primary">
					Save changes
				</Button>
			</ModalFooter>
		</Modal>
	</DocSection>

	<DocSection
		Subpath="components/modal/#optional-sizes"
		Title="Optional sizes">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#xlModal">
			Extra large modal
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#lgModal">
			Large modal
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#smModal">
			Small modal
		</Button>

		<Modal
			Size="ExtraLarge"
			Fade
			id="xlModal">
			<ModalHeader Title="Extra large modal"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			Size="Large"
			Fade
			id="lgModal">
			<ModalHeader Title="Large modal"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			Size="Small"
			Fade
			id="smModal">
			<ModalHeader Title="Small modal"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Interjection>
			<strong>Be aware:</strong> you can explicitly supply <code>Size="Size.Medium"</code> if you wish, but this value is ignored if present.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/modal/#fullscreen-modal"
		Title="Fullscreen modal">
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreen">
			Full screen
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreenSm">
			Full screen below sm
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreenMd">
			Full screen below md
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreenLg">
			Full screen below lg
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreenXl">
			Full screen below xl
		</Button>
		<Button
			Color="Primary"
			Toggle="Toggle.Modal"
			Target="#fullscreenXxl">
			Full screen below xxl
		</Button>

		<Modal
			FullscreenOn="Xs"
			Fade
			id="fullscreen">
			<ModalHeader Title="Full screen modal"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			FullscreenOn="Sm"
			Fade
			id="fullscreenSm">
			<ModalHeader Title="Full screen below sm"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			FullscreenOn="Md"
			Fade
			id="fullscreenMd">
			<ModalHeader Title="Full screen below md"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			FullscreenOn="Lg"
			Fade
			id="fullscreenLg">
			<ModalHeader Title="Full screen below lg"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			FullscreenOn="Xl"
			Fade
			id="fullscreenXl">
			<ModalHeader Title="Full screen below xl"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Modal
			FullscreenOn="Xxl"
			Fade
			id="fullscreenXxl">
			<ModalHeader Title="Full screen below xxl"/>
			<ModalBody>
				<p>...</p>
			</ModalBody>
		</Modal>

		<Interjection>
			<strong>FYI:</strong> To indicate a modal should be full-screen on every breakpoint, you must explicitly provide <code>FullscreenOn="Breakpoint.Xs"</code>. This is because if <code>FuullscreenOn</code> is <code>null</code>, it has no effect at all (otherwise, modals would be fullscreen on all breakpoints by default).
		</Interjection>
	</DocSection>
</DocPage>
