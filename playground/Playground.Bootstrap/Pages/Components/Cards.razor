@page "/components/cards";

<DocPage Title="Cards">
	<DocSection
		Subpath="components/card/#example"
		Title="Example">
		<Card style="width: 18rem;">
			<CardImage
				Position="Top"
				src="https://placehold.co/600x400?text=Image+cap"/>
			<CardBody>
				<CardTitle Tag="h5">
					Card title
				</CardTitle>

				<CardText>
					Some quick example text to build on the card title and make up the bulk of the card’s content.
				</CardText>

				<Btn
					Color="Primary"
					href="#">
					Go somewhere
				</Btn>
			</CardBody>
		</Card>
	</DocSection>

	<DocSection
		Subpath="components/card/#body"
		Title="Content types - body">
		<Card>
			<CardBody>
				This is some text within a card body.
			</CardBody>
		</Card>
	</DocSection>

	<DocSection
		Subpath="components/card/#titles-text-and-links"
		Title="Content types - titles, text, and links">
		<Card style="width: 18rem;">
			<CardBody>
				<CardTitle Tag="h5">
					Card title
				</CardTitle>
				<CardSubtitle
					Tag="h6"
					class="text-body-secondary mb-2">
					Card subtitle
				</CardSubtitle>

				<CardText>
					Some quick example text to build on the card title and make up the bulk of the card’s content.
				</CardText>

				<CardLink href="#">Card link</CardLink>
				<CardLink href="#">Another link</CardLink>
			</CardBody>
		</Card>
	</DocSection>

	<DocSection
		Subpath="components/card/#titles-text-and-links"
