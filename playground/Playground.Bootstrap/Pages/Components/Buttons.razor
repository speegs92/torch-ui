@page "/components/buttons"

<DocPage Title="Buttons">
	<DocSection
		Subpath="components/buttons/#base-class"
		Title="Base class">
		<Btn>Base class</Btn>
	</DocSection>

	<DocSection
		Subpath="components/buttons/#variants"
		Title="Variants">
		<Btn Color="Primary">Primary</Btn>
		<Btn Color="Secondary">Secondary</Btn>
		<Btn Color="Success">Success</Btn>
		<Btn Color="Danger">Danger</Btn>
		<Btn Color="Warning">Warning</Btn>
		<Btn Color="Info">Info</Btn>
		<Btn Color="Light">Light</Btn>
		<Btn Color="Dark">Dark</Btn>

		<Interjection>
			<strong>Be aware:</strong> <code>&lt;Button&gt;</code> does not currently support the <code>.btn-link</code> variant. You can achieve this by adding the <code>.btn-link</code> class directly to a plain <code>&lt;Button&gt;</code>, e.g. <code>&lt;Button class="btn-link"&gt;</code>.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/buttons/#button-tags"
		Title="Button tags">
		<Btn Color="Primary" href="#">Link</Btn>
		<Btn Color="Primary">Button</Btn>
		<Btn Color="Primary" value="Input"/>
		<Btn Color="Primary" type="submit">Submit</Btn>
		<Btn Color="Primary" type="submit" value="Submit"/>
		<Btn Color="Primary" type="reset">Reset</Btn>
		<Btn Color="Primary" type="reset" value="Reset"/>
	</DocSection>

	<DocSection
		Subpath="components/buttons/#outline-buttons"
		Title="Outline buttons">
		<Btn Color="Primary" Outlined>Primary</Btn>
		<Btn Color="Secondary" Outlined>Secondary</Btn>
		<Btn Color="Success" Outlined>Success</Btn>
		<Btn Color="Danger" Outlined>Danger</Btn>
		<Btn Color="Warning" Outlined>Warning</Btn>
		<Btn Color="Info" Outlined>Info</Btn>
		<Btn Color="Light" Outlined>Light</Btn>
		<Btn Color="Dark" Outlined>Dark</Btn>
	</DocSection>

	<DocSection
		Subpath="components/buttons/#sizes"
		Title="Sizes">
		<Btn Color="Primary" Size="Large">Large button</Btn>
		<Btn Color="Primary" Size="Small">Small button</Btn>

		<Interjection>
			<strong>Be aware:</strong> Bootstrap buttons do not support the extra-large size.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/buttons/#toggle-states"
		Title="Toggle states">
		<p class="d-inline-flex gap-1">
			<ToggleBtn Color="Primary" Toggle="Button">Toggle button</ToggleBtn>
			<ToggleBtn Color="Primary" Toggle="Button" Active>Active toggle button</ToggleBtn>
			<ToggleBtn Color="Primary" Toggle="Button" disabled>Disabled toggle button</ToggleBtn>
		</p>

		<Interjection>
			<strong>Be aware:</strong> setting <code>Toggle="Toggle.Button"</code> and <code>Active="true"</code> on a <code>&lt;Button&gt;</code> component will automatically apply the <code>.active</code> class and <code>aria-pressed="true"</code> attributes, as recommended in the Bootstrap 5.3 docs.
		</Interjection>
	</DocSection>
</DocPage>
