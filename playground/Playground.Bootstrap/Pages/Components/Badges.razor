		Title="Buttons">
		<Button Color="Primary">
			Notifications
			<Badge Color="Secondary">
				4
			</Badge>
		</Button>
	</DocSection>

	<DocSection
		Subpath="components/badge/#positioned"
		Title="Positioned">
		<Button
			Color="Primary"
			class="position-relative">
			Inbox
			<Badge
				Color="Danger"
				Pill
				class="position-absolute top-0 start-100 translate-middle">
				99+
				<span class="visually-hidden">
					unread messages
				</span>
			</Badge>
		</Button>

		<Interjection>
			<strong>FYI:</strong> The "red circle" example in the Bootstrap docs is not included because, as useful as the example might be for some designs, it is not a badge as such - it doesn't even use the <code>.badge</code> class.
		</Interjection>
	</DocSection>

	<DocSection
		Subpath="components/badge/#background-colors"
		Title="Background colors">
		<Badge Color="Primary">Primary</Badge>
		<Badge Color="Secondary">Secondary</Badge>
		<Badge Color="Success">Success</Badge>
