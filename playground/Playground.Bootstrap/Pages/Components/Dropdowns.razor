@page "/components/dropdowns"

<DocPage Title="Dropdowns">
	<DocSection
		Subpath="components/dropdowns/#single-button"
		Title="Examples - Single button">
		<Dropdown
			Text="Dropdown button"
			Color="Secondary"
			class="mb-2">
			<DropdownItemLink Href="#">Action</DropdownItemLink>
			<DropdownItemLink Href="#">Another action</DropdownItemLink>
			<DropdownItemLink Href="#">Something else here</DropdownItemLink>
		</Dropdown>

		<div class="d-flex">
			@foreach (var color in Enum.GetValues<ThemeColor>()[..^2])
			{
				<Dropdown class="me-2">
					<ToggleBtn
						Color="color"
						Toggle="Toggle.Dropdown">
						@color.ToString()
					</ToggleBtn>
					<DropdownMenu>
						<DropdownItemLink Href="#">Action</DropdownItemLink>
						<DropdownItemLink Href="#">Another action</DropdownItemLink>
						<DropdownItemLink Href="#">Something else here</DropdownItemLink>
						<DropdownDivider/>
						<DropdownItemLink Href="#">Separated link</DropdownItemLink>
					</DropdownMenu>
				</Dropdown>
			}
		</div>
	</DocSection>

	<DocSection
		Subpath="components/dropdowns/#split-button"
		Title="Examples - Split button">
		<SplitDropdown
			Text="Split ropdown button"
			Color="Secondary"
			class="mb-2">
			<DropdownItemLink Href="#">Action</DropdownItemLink>
			<DropdownItemLink Href="#">Another action</DropdownItemLink>
			<DropdownItemLink Href="#">Something else here</DropdownItemLink>
		</SplitDropdown>

		<div class="d-flex">
			@foreach (var color in Enum.GetValues<ThemeColor>()[..^2])
			{
				<SplitDropdown class="me-2">
					<Btn Color="color">@color.ToString()</Btn>
					<DropdownToggleSplitBtn Color="color"/>

					<DropdownMenu>
						<DropdownItemLink Href="#">Action</DropdownItemLink>
						<DropdownItemLink Href="#">Another action</DropdownItemLink>
						<DropdownItemLink Href="#">Something else here</DropdownItemLink>
						<DropdownDivider/>
						<DropdownItemLink Href="#">Separated link</DropdownItemLink>
					</DropdownMenu>
				</SplitDropdown>
			}
		</div>
	</DocSection>

